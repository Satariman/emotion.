{
  "info": {
    "_postman_id": "18ba2ac5-b3df-4c21-bf39-985ec363b278",
    "name": "SeminarDesk — основные сценарии",
    "description": "Импортируйте коллекцию в Postman и запустите её целиком в указанном порядке. Запросы сохраняют токены, ID заявки и её текущую версию автоматически.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5080",
      "type": "string"
    },
    {
      "key": "aliceToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bobToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "operatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketVersion",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API is healthy\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.deep.include({ status: \"ok\", service: \"rbpo-helpdesk\" });",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02. Authenticate",
      "item": [
        {
          "name": "Login as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"alice\",\n  \"password\": \"Alice-demo-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Alice receives a token\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"aliceToken\", response.token);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login as Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"bob\",\n  \"password\": \"Bob-demo-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bob receives a token\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"bobToken\", response.token);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login as operator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"operator\",\n  \"password\": \"Operator-demo-2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Operator receives a token\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"operatorToken\", response.token);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "03. Student creates a ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Printer unavailable\",\n  \"description\": \"Cannot print the seminar materials.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/tickets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ticket is created for Alice\", function () {",
              "  pm.response.to.have.status(201);",
              "  const response = pm.response.json();",
              "  pm.expect(response.id).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(response.status).to.eql(\"New\");",
              "  pm.expect(response.version).to.eql(1);",
              "  pm.collectionVariables.set(\"ticketId\", response.id);",
              "  pm.collectionVariables.set(\"ticketVersion\", String(response.version));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04. Bob cannot read Alice's ticket",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bobToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Foreign ticket remains hidden\", function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json()).to.deep.equal({ error: \"ticket_not_found\" });",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05. Operator processes ticket",
      "item": [
        {
          "name": "Accept ticket",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"InProgress\",\n  \"expectedVersion\": {{ticketVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Operator accepts the ticket\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.status).to.eql(\"InProgress\");",
                  "  pm.collectionVariables.set(\"ticketVersion\", String(response.version));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Add operator comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The operator is checking it.\",\n  \"expectedVersion\": {{ticketVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Operator adds a comment\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.ticketVersion).to.be.a(\"number\");",
                  "  pm.collectionVariables.set(\"ticketVersion\", String(response.ticketVersion));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Resolve ticket",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Resolved\",\n  \"expectedVersion\": {{ticketVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Operator resolves the ticket\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.status).to.eql(\"Resolved\");",
                  "  pm.collectionVariables.set(\"ticketVersion\", String(response.version));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "06. Closed ticket guards",
      "item": [
        {
          "name": "Alice cannot edit a ticket in progress or resolved",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Printer unavailable\",\n  \"description\": \"Late edit must be rejected.\",\n  \"expectedVersion\": {{ticketVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Late edit is rejected\", function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json()).to.deep.equal({ error: \"ticket_already_in_progress\" });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "No comments after resolution",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Late comment must be rejected.\",\n  \"expectedVersion\": {{ticketVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Late comment is rejected\", function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json()).to.deep.equal({ error: \"ticket_resolved\" });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "07. Operator reads audit log",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operatorToken}}"
          }
        ],
        "url": "{{baseUrl}}/audit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Audit contains the ticket lifecycle\", function () {",
              "  pm.response.to.have.status(200);",
              "  const events = pm.response.json().filter(event => event.ticketId === pm.collectionVariables.get(\"ticketId\"));",
              "  pm.expect(events.map(event => event.action)).to.deep.equal([\"ticket_created\", \"status_changed\", \"comment_added\", \"status_changed\"]);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
